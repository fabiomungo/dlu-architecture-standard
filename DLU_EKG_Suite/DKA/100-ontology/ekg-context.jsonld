      "@id": "dlu:definesCLO",
      "@type": "@id"
    },
    "definesMLO": {
      "@id": "dlu:definesMLO",
      "@type": "@id"
    },
    "contributesTo": {
      "@id": "dlu:contributesTo",
      "@type": "@id"
    },
