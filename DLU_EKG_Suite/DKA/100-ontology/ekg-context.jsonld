      "@id": "dlu:addresses",
      "@type": "@id"
    },
    "teaches": {
      "@id": "dlu:teaches",
      "@type": "@id"
    },
    "prerequisiteOf": {
      "@id": "dlu:prerequisiteOf",
      "@type": "@id"
    },
    "develops": {
      "@id": "dlu:develops",
